# ---------------------------------------------------------------------------
# DART & Case Tracker - environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In production these live in the Netlify UI (Site settings > Environment).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (safe for the browser). Current Supabase naming - starts
# with sb_publishable_. This replaced the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Secret key (server only). Current Supabase naming - starts with sb_secret_.
# This replaced the legacy "service_role" key. It bypasses Row Level Security,
# so it must never be imported into a client component or exposed to a browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Resend - used only by the two scheduled reminder functions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
REMINDER_FROM_EMAIL=DART Tracker <dart@yourdomain.com>

# Public base URL of the deployed app. Used to build the "open the app" link
# inside reminder emails.
APP_URL=https://your-site.netlify.app

# Shared secret guarding the manual HTTP trigger on the reminder functions,
# so the cron can be tested before it is enabled in production.
REMINDER_TEST_TOKEN=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Web push notifications - the hourly nag from 5pm until someone submits.
#
# Generate once with:  npx web-push generate-vapid-keys --json
#
# NEVER rotate these on a live site. Changing them silently invalidates every
# existing subscription and every phone goes quiet without anyone noticing.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ---------------------------------------------------------------------------
# Local RLS test harness only (tests/db). Not needed in production.
# Set by scripts/test-db.sh when it boots a throwaway PostgreSQL 16 cluster.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/dart_test
